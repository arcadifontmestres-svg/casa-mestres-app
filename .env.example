# ─────────────────────────────────────────────────────────────
# COPIA aquest fitxer com a .env NOMÉS per executar l'app al PC.
# A Render, introdueix aquests valors a Environment Variables.
# NO pugis MAI .env a GitHub (ja està exclòs al .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Xarxa local ───────────────────────────────────────────────
# Render estableix HOST=0.0.0.0 i PORT automàticament.
HOST=127.0.0.1
PORT=3210

# ── Back Office (OBLIGATORI) ──────────────────────────────────
# Tria un usuari i una contrasenya forts. El Back Office i les
# API de gestió estan protegits amb HTTP Basic Auth.
ADMIN_USER=canvia_aquest_usuari
ADMIN_PASSWORD=canvia_aquesta_contrasenya

# ── Stripe (opcional al començament) ──────────────────────────
# Entra-ho quan tinguis el compte de Stripe creat.
# Test:    sk_test_...
# Live:    sk_live_...
STRIPE_SECRET_KEY=

# Es crea al Dashboard de Stripe > Developers > Webhooks
# després del primer deploy (quan ja tinguis la URL pública).
STRIPE_WEBHOOK_SECRET=

# ── URL pública (OBLIGATORI a producció) ──────────────────────
# A local: http://127.0.0.1:3210
# A Render: https://casa-mestres.onrender.com  (sense barra final)
APP_BASE_URL=http://127.0.0.1:3210

# ── Persistència ─────────────────────────────────────────────
# En blanc = data.json a la mateixa carpeta (OK per local).
# A Render: /var/data  (requereix disc persistent al servei).
DATA_DIR=

# Gmail OAuth: configuració única de l’administrador del servei.
# Activar Gmail API i crear un client OAuth de tipus Web a Google Cloud.
# Retorn autoritzat: APP_BASE_URL/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
